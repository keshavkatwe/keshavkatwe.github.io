---
import '../styles/global.css';
import BugBash from '../components/BugBash.astro';
import Background from '../components/Background.astro';
import ToolgrainArt from '../components/ToolgrainArt.astro';
import { projects } from '../data/projects';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Keshav Katwe — Engineer. Builder. A little playful.</title>
<meta name="description" content="The interactive workshop of Keshav Katwe. Senior Frontend & React Native Engineer in Dubai. Explore 11+ years of engineering, independent products, and a little arcade."/>
<link rel="canonical" href="https://keshavkatwe.github.io/"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
<meta name="theme-color" content="#f5f3ec"/><meta property="og:title" content="Keshav Katwe — Good engineering. Great energy."/><meta property="og:description" content="React. React Native. Products with a pulse. Step inside my interactive workshop."/><meta property="og:type" content="website"/>
</head>
<body class="playground-page">
<a class="skip" href="#main">Skip to content</a>
<header class="nav"><a class="wordmark" href="/" aria-label="Keshav Katwe home">kk<span aria-hidden="true">✳</span><small>ENGINEER &<br/>PRODUCT BUILDER</small></a><nav aria-label="Main navigation"><a href="#work">Work <sup>{String(projects.length).padStart(2,'0')}</sup></a><a href="#play">Play <span class="nav-dot"></span></a><a href="#about">About</a><a href="#contact" class="nav-contact">Let’s talk ↗</a></nav><button id="motion-toggle" aria-pressed="false" aria-label="Pause animations" title="Pause animations">Ⅱ</button></header>
<main id="main">
<section class="hero" aria-labelledby="hero-title">
 <div class="hero-top"><span class="eyebrow"><i></i> Keshav Katwe · Dubai, UAE</span><span class="hero-edition">INDEPENDENT MIND. BUILDER’S HANDS. <span id="dubai-time"></span></span></div>
 <div class="hero-composition">
  <div class="hero-type"><p class="hero-role">SENIOR FRONTEND & REACT NATIVE ENGINEER</p><h1 id="hero-title">Good<br/>engineering<span class="title-period">.</span><br/><span class="outlined">Great</span> <span class="energy">energy<svg viewBox="0 0 500 30" aria-hidden="true"><path d="M5 22Q220 -7 492 10"/></svg></span><span class="title-period">.</span></h1><div class="hero-intro"><span class="intro-arrow" aria-hidden="true">↳</span><p>I turn complicated ideas into products<br class="desktop"/> that feel good to use. And I like to have<br class="desktop"/> a little fun along the way.</p></div><div class="hero-actions"><a class="pill-button primary" href="#work">Explore my work <span>↗</span></a><a class="hero-play" href="#play"><span>▶</span> Take a play break</a></div></div>
  <div class="sculpture-zone">
   <span class="sculpture-coordinate coord-top">FIG. 001 — A CURIOUS MIND</span>
   <button class="sculpture-button" id="remix-sculpture" aria-label="Remix the interactive sculpture" title="Move around. Click to remix.">
    <svg class="sculpture-fallback" viewBox="0 0 600 600" aria-hidden="true"><defs><linearGradient id="chrome" x1="0" x2="1" y1="0" y2="1"><stop stop-color="#092a9e"/><stop offset=".24" stop-color="#83a8ff"/><stop offset=".42" stop-color="#f0f4ff"/><stop offset=".49" stop-color="#2447de"/><stop offset=".74" stop-color="#173087"/><stop offset=".9" stop-color="#9bb6ff"/><stop offset="1" stop-color="#315bfb"/></linearGradient></defs><g fill="none" stroke="url(#chrome)" stroke-width="48"><ellipse cx="300" cy="300" rx="178" ry="87" transform="rotate(-35 300 300)"/><ellipse cx="300" cy="300" rx="178" ry="87" transform="rotate(70 300 300)"/><ellipse cx="300" cy="300" rx="178" ry="87" transform="rotate(10 300 300)"/></g></svg>
    <canvas id="sculpture-canvas" aria-hidden="true"></canvas>
    <span class="sculpture-hint"><span>↔</span> MOVE IT. CLICK TO REMIX.</span>
   </button>
   <a class="orbit-sticker" href="#play" aria-label="Play the Bug Bash arcade"><svg viewBox="0 0 120 120" aria-hidden="true"><path d="M60 0L72 14L89 8L94 26L112 29L108 48L120 60L106 72L112 89L94 94L89 112L71 108L60 120L48 106L30 112L26 94L8 89L12 71L0 60L14 48L8 30L26 26L30 8L49 12Z" fill="currentColor"/></svg><span>A LITTLE<br/>LESS SCROLL.<br/><b>MORE PLAY ↗</b></span></a>
   <span class="sculpture-coordinate coord-bottom">CRAFT × CURIOSITY × A BIT OF CHAOS</span><span class="sculpture-mark" aria-hidden="true">+</span>
  </div>
 </div>
 <div class="hero-footer"><p><strong>11+ YEARS</strong> of making things work.<br/><span>React · React Native · TypeScript · Architecture</span></p><div class="hero-availability"><span></span> OPEN TO MY NEXT CHAPTER</div><a href="#work" class="scroll-cue" aria-label="Scroll to selected work">↓</a></div>
</section>
<div class="ticker" aria-label="Build with intent. Make room for play."><div aria-hidden="true">BUILD WITH INTENT <span>✳</span> MAKE ROOM FOR PLAY <span>↗</span> SWEAT THE DETAILS <span>✳</span> BUILD WITH INTENT <span>✳</span> MAKE ROOM FOR PLAY <span>↗</span> SWEAT THE DETAILS <span>✳</span></div></div>
<section class="work section" id="work" aria-labelledby="work-title">
 <div class="section-topline"><span class="eyebrow">01 / Things I’ve put into the world</span><span class="mono">SELECTED WORK · 2023—2026</span></div>
 <div class="work-heading"><h2 id="work-title">Less talking.<br/><span class="serif-word">More building.</span></h2><p>Independent products. Real-world systems.<br/>A few of my favourite engineering rabbit holes.</p><span class="section-spark" aria-hidden="true">✳</span></div>
 <div class="project-list">{projects.map(project => <article class={`project ${project.slug}`} id={project.slug}>
  <div class="project-meta"><span class="project-index">/{project.number}</span><span>{project.type}</span><span class="mono">{project.slug==='pushwing'?'WEB / MCP':project.slug==='agenvik'?'AI / AGENTS':project.slug==='toolgrain'?'TYPESCRIPT / MCP':project.slug==='investsky'?'IOS / ANDROID':'SYSTEMS / DX'}</span></div>
  <div class="project-layout">
   <a class="project-art" href={`/work/${project.slug}/`} aria-label={`Read the ${project.name} engineering story`} data-tilt>
    {project.slug==='pushwing' ? <><div class="art-grid" aria-hidden="true"></div><span class="art-word" aria-hidden="true">push<br/>the idea.</span><div class="product-window"><div class="window-chrome"><span>● ● ●</span><span>pushwing.com</span><span>↗</span></div><img src={project.image} width="1280" height="720" loading="lazy" alt="Pushwing public website showing AI-connected publishing"/></div><span class="product-sticker" aria-hidden="true">IDEA →<br/>PUBLISHED.</span></> : project.slug==='agenvik' ? <><div class="agent-orbits" aria-hidden="true"><i></i><i></i><i></i><span>✳</span></div><div class="agent-bubble bubble-one" aria-hidden="true">Context is everything.</div><div class="agent-bubble bubble-two" aria-hidden="true">Good thing I remember. <span>↗</span></div><div class="product-window"><div class="window-chrome"><span>● ● ●</span><span>agenvik.com</span><span>↗</span></div><img src={project.image} width="1906" height="1280" loading="lazy" alt="Agenvik published demo workspace with agent configuration"/></div></> : project.slug==='toolgrain' ? <ToolgrainArt/> : project.slug==='investsky' ? <><span class="finance-giant" aria-hidden="true">↗</span><div class="finance-phone" aria-hidden="true"><span class="phone-island"></span><div class="phone-title">A LITTLE MOMENTUM <span>↗</span></div><h4>Good things<br/>are growing.</h4><svg viewBox="0 0 280 150" class="finance-chart"><defs><linearGradient id="chart-fill" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#d9ff43" stop-opacity=".5"/><stop offset="1" stop-color="#d9ff43" stop-opacity="0"/></linearGradient></defs><path class="chart-area" d="M0 135L25 123L45 128L65 97L85 107L108 75L130 85L148 53L168 67L189 33L212 43L235 13L255 24L280 3V150H0Z"/><path class="chart-line" d="M0 135L25 123L45 128L65 97L85 107L108 75L130 85L148 53L168 67L189 33L212 43L235 13L255 24L280 3"/></svg><div class="phone-periods"><span>1D</span><span>1W</span><span class="selected">1M</span><span>1Y</span></div><p>Thoughtful details.<br/><strong>All the way down.</strong></p></div><span class="finance-label" aria-hidden="true">BUILT FOR<br/>THE THUMB ZONE.</span></> : <><div class="sense-lines" aria-hidden="true"></div><div class="ship-interface" aria-hidden="true"><div class="ship-top"><span>DEPLOYMENT PIPELINE</span><span>● LIVE</span></div><div class="ship-number"><small>20 min</small><span>↘</span><strong>&lt;60<em>sec</em></strong></div><div class="ship-steps"><span>01 BUILD <i>✓</i></span><span>02 CHECK <i>✓</i></span><span>03 SHIP <i>↗</i></span></div><div class="ship-bottom">LESS WAITING. MORE MAKING.</div></div><span class="sense-spark" aria-hidden="true">✳</span></>}
    <span class="art-caption">{project.caption}</span><span class="art-open" aria-hidden="true">↗</span>
   </a>
   <div class="project-copy"><h3><a href={`/work/${project.slug}/`}>{project.name}<span>↗</span></a></h3><h4>{project.headline}</h4><p>{project.description}</p><div class="tags">{project.tags.map(tag=><span>{tag}</span>)}</div><a class="project-link" href={`/work/${project.slug}/`}>Inside the build <span>↗</span></a><div class="project-external-links">{project.url && <a class="project-external" href={project.url} target="_blank" rel="noreferrer">{project.slug==='toolgrain'?'View package on npm':'Visit the product'} ↗</a>}{'repository' in project && <a class="project-external" href={project.repository} target="_blank" rel="noreferrer">View source on GitHub ↗</a>}</div></div>
  </div>
 </article>)}</div>
 <p class="results-note">Employer results are candidate-reported. Product images are public visuals. Mobile artwork is an original interaction study.</p>
</section>
<BugBash/>
<section class="about section" id="about" aria-labelledby="about-title">
 <div class="section-topline"><span class="eyebrow">03 / The human in the loop</span><span class="mono">STILL CURIOUS. STILL BUILDING.</span></div>
 <div class="about-layout"><div class="about-art"><div class="about-avatar" aria-hidden="true"><div class="avatar-eyes"><i></i><i></i></div><div class="avatar-smile"></div><span class="avatar-star">✳</span></div><span class="about-art-note">ENGINEER BY TRADE.<br/>BUILDER AT HEART. ↗</span><span class="about-sticker">HELLO,<br/>I’M KESHAV.</span></div><div class="about-copy"><h2 id="about-title">Serious about<br/>the work.<br/><span class="serif-word">Curious about<br/>everything.</span></h2><p>I’ve spent 11+ years building web and mobile products at Paytm, InvestSky, invygo and Sense. I like architecture that makes sense, interfaces that feel right, and getting things shipped.</p><p>These days, I’m also building Pushwing, Agenvik and Toolgrain. I use Claude and Codex every day. My job is still to ask the right questions, draw the boundaries, review the details, and take responsibility for what ships.</p><a class="pill-button primary" href="/Keshav-Katwe-Resume.pdf" target="_blank">Get the full story <span>↓</span></a></div></div>
 <div class="skill-rail" aria-label="Areas of expertise"><span>React & React Native</span><span>TypeScript</span><span>Frontend architecture</span><span>Design systems</span><span>Agents & MCP</span></div>
</section>
<Background/>
<section class="contact section" id="contact" aria-labelledby="contact-title"><div class="section-topline"><span class="eyebrow"><i></i> Dubai, UAE · Available for opportunities</span><span class="mono">04 / YOUR MOVE</span></div><div class="contact-title"><h2 id="contact-title">Let’s make<br/>some <span class="serif-word">good</span><br/>trouble<span>✳</span></h2><a class="contact-orb" href="mailto:keshav.katwe@gmail.com" aria-label="Email Keshav about an opportunity"><span>GOT AN IDEA?</span><strong>↗</strong><span>LET’S TALK.</span></a></div><div class="contact-bottom"><a href="mailto:keshav.katwe@gmail.com">keshav.katwe@gmail.com ↗</a><button id="copy-email">Copy email <span>⧉</span></button><span id="copy-status" role="status"></span><p>Good people. Interesting problems.<br/>Something worth building.</p></div></section>
</main>
<footer><a class="wordmark" href="/" aria-label="Back to top">kk<span>✳</span></a><p>A LITTLE CRAFT. A LITTLE CHAOS. © {new Date().getFullYear()}</p><div><a href="https://www.linkedin.com/in/keshavkatwe/" target="_blank" rel="noreferrer">LinkedIn ↗</a><a href="https://github.com/keshavkatwe" target="_blank" rel="noreferrer">GitHub ↗</a><a href="/Keshav-Katwe-Resume.pdf" target="_blank">Résumé ↗</a></div></footer>
<div class="scroll-progress" aria-hidden="true"></div><div class="cursor-label" aria-hidden="true">EXPLORE ↗</div>
<script>import '../scripts/motion'; import '../scripts/sculpture';</script>
</body></html>
