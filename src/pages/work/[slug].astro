---
import '../../styles/global.css';
import '../../styles/story.css';
import { projects } from '../../data/projects';
import { stories } from '../../data/stories';
export function getStaticPaths() { return projects.map((project,index) => ({ params:{slug:project.slug}, props:{project,index} })); }
const { project, index } = Astro.props;
const story = stories[project.slug];
const next = projects[(index + 1) % projects.length];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>{project.name} — Engineering story · Keshav Katwe</title>
  <meta name="description" content={story.outcome}/>
  <link rel="canonical" href={`https://keshavkatwe.github.io/work/${project.slug}/`}/>
  <link rel="icon" href="/favicon.svg"/>
  <meta name="theme-color" content="#f5f3ec"/>
</head>
<body class="story-page" data-project={project.slug} style={`--card:${project.color}`}>
  <a class="skip" href="#main">Skip to content</a>
  <header class="nav">
    <a class="wordmark" href="/" aria-label="Keshav Katwe home">kk<span aria-hidden="true">✳</span></a>
    <nav aria-label="Main navigation">
      <a href="/#work">Work <sup>04</sup></a>
      <a href="/#play">Play ↗</a>
      <a class="nav-contact" href="mailto:keshav.katwe@gmail.com">Let’s talk ↗</a>
    </nav>
    <button id="motion-toggle" aria-pressed="false" aria-label="Pause animations">Ⅱ</button>
  </header>
  <main id="main">
    <section class="story-hero section">
      <div class="story-topline">
        <a class="back-link" href={`/#${project.slug}`}><span aria-hidden="true">↖</span> Back to the workshop</a>
        <span class="story-edition">Case file / {project.number} of 04</span>
      </div>
      <div class="story-kicker">
        <span class="eyebrow"><i aria-hidden="true"></i> Engineering story</span>
        <span>{story.scope}</span>
      </div>
      <div class="story-title-row">
        <h1>{project.name}</h1>
        <div class="story-stamp" aria-hidden="true"><span>Under<br/>the hood</span><svg viewBox="0 0 100 100" fill="none"><path d="M50 2v96M2 50h96M16 16l68 68M16 84l68-68" stroke="currentColor" stroke-width="14"/></svg></div>
      </div>
      <div class="story-hero-bottom">
        <p class="story-headline">{project.headline}</p>
        <div class="story-hero-summary"><p class="story-intro">{project.description}</p><div class="tags">{project.tags.map(tag=><span>{tag}</span>)}</div></div>
      </div>
      <nav class="story-jump" aria-label="In this case study">
        <a href="#challenge"><span>01 / Challenge</span><span aria-hidden="true">↓</span></a>
        <a href="#decisions"><span>02 / Decisions</span><span aria-hidden="true">↓</span></a>
        <a href="#evidence"><span>03 / Evidence</span><span aria-hidden="true">↓</span></a>
      </nav>
    </section>

    <section class="story-results" aria-label={`${project.name} at a glance`}>
      <div class="story-results-inner">{story.results.map((result,i)=><div class="story-result"><span class="result-index">0{i+1} / At a glance</span><strong>{result.value}</strong><span class="result-label">{result.label}</span></div>)}</div>
    </section>

    <section class="story-section section" id="challenge">
      <div class="story-side-label"><span class="eyebrow">01 / The challenge</span><span class="story-section-glyph" aria-hidden="true">↳</span></div>
      <div class="story-reading">
        <h2>{project.slug==='sense' ? 'Better systems.\nBetter shipping.' : 'A product problem,\nnot just a screen.'}</h2>
        <p>{story.problem}</p>
        <div class="ownership"><span class="ownership-icon" aria-hidden="true">✳</span><div><h3>What I owned</h3><p>{story.ownership}</p></div></div>
      </div>
    </section>

    <section class="story-flow" aria-labelledby="flow-title">
      <div class="story-flow-inner section">
        <div class="flow-heading"><span class="eyebrow">Interactive system explorer</span><h2 id="flow-title">{story.flowTitle}<span aria-hidden="true">↘</span></h2><p>{story.flowNote}</p></div>
        <ol class="flow-steps">{story.flow.map((step,i)=><li><a href={`#step-${i}`} aria-controls={`step-${i}`}><span class="flow-number">0{i+1}</span><span class="flow-step-glyph" aria-hidden="true">{['↗','⌘','✳','↻'][i]}</span><strong>{step.title}</strong><span class="flow-step-arrow" aria-hidden="true">↗</span></a></li>)}</ol>
        <div class="flow-panels">{story.flow.map((step,i)=><section class="flow-panel" id={`step-${i}`} aria-labelledby={`step-title-${i}`}><span class="flow-number">Step / 0{i+1}</span><div><h3 id={`step-title-${i}`}>{step.title}</h3><p>{step.detail}</p></div><span class="flow-panel-orbit" aria-hidden="true">✳</span></section>)}</div>
        <div class="flow-footer"><span>Click a module. Explore the thinking.</span><span aria-hidden="true">[ 01 — 04 ]</span></div>
      </div>
    </section>

    <section class="story-decisions section" id="decisions">
      <div class="story-decisions-heading"><span class="eyebrow">02 / Engineering decisions</span><h2>The choices<br/>behind the work<span aria-hidden="true">.</span></h2></div>
      <div class="decision-list">{story.decisions.map((decision,i)=><article><div class="decision-topline"><span class="decision-number">0{i+1}</span><span aria-hidden="true">{['↗','⊕','✳'][i]}</span></div><h3>{decision.title}</h3><div class="decision-copy"><h4>What I built</h4><p>{decision.built}</p><h4>Why it matters</h4><p>{decision.significance}</p></div></article>)}</div>
    </section>

    <section class="story-evidence section" id="evidence">
      <div class="evidence-heading"><span class="eyebrow">03 / Evidence & results</span><span class="evidence-glyph" aria-hidden="true">✳</span></div>
      <h2>{story.outcome}</h2>
      <div class="evidence-note"><span class="eyebrow">The context matters</span><p>{story.evidence}</p></div>
      {project.image && <figure class="story-figure"><div class="story-figure-bar"><span><i></i><i></i><i></i></span><span>{project.slug==='pushwing'?'pushwing.com':'agenvik.com'} / Public product surface</span><span aria-hidden="true">↗</span></div><img src={project.image} width={project.slug==='pushwing'?1280:1906} height={project.slug==='pushwing'?720:1280} loading="lazy" alt={project.slug==='pushwing'?'Pushwing public product website':'Agenvik published demo showing knowledge sources and agent configuration'}/><figcaption>{project.caption}</figcaption></figure>}
      {project.slug==='pushwing' && <div class="story-demo"><div><span class="eyebrow">Press play / Product walkthrough</span><h3>See the product<br/>in motion<span aria-hidden="true">↘</span></h3><p>The existing public Pushwing walkthrough. Play on demand.</p></div><video controls preload="none" playsinline aria-label="Pushwing product walkthrough"><source src="https://pushwing.com/media/pushwing-how-it-works.mp4" type="video/mp4"/>Your browser cannot play this video. <a href="https://pushwing.com/media/pushwing-how-it-works.mp4">Open the walkthrough</a>.</video><a class="text-link" href="https://pushwing.com/media/pushwing-how-it-works.mp4" target="_blank" rel="noreferrer">Open walkthrough ↗</a></div>}
      <div class="story-evidence-links">
        {project.url && <a class="text-link" href={project.url} target="_blank" rel="noreferrer">{project.link} ↗</a>}
        {'repository' in project && <a class="text-link" href={project.repository} target="_blank" rel="noreferrer">View source on GitHub ({project.license}) ↗</a>}
        {project.slug==='agenvik' && <a class="text-link" href="https://agenvik.com/docs/developer-guide/overview" target="_blank" rel="noreferrer">Read the developer guide ↗</a>}
        {(project.slug==='investsky'||project.slug==='sense') && <a class="text-link" href="/Keshav-Katwe-Resume.pdf" target="_blank">View résumé and reported results ↗</a>}
      </div>
    </section>

    <section class="story-next"><div class="story-next-inner section"><div class="next-topline"><span class="eyebrow">There’s more in the workshop</span><span class="eyebrow">Up next / {next.number}</span></div><a href={`/work/${next.slug}/`}><span>{next.name}</span><span class="next-arrow" aria-hidden="true">↗</span></a><p>{next.headline}</p></div></section>
  </main>
  <footer><a class="wordmark" href="/">keshav<span>✳</span></a><p>Senior frontend & React Native engineer · Dubai</p><div><a href="mailto:keshav.katwe@gmail.com">Email ↗</a><a href="https://www.linkedin.com/in/keshavkatwe/" target="_blank" rel="noreferrer">LinkedIn ↗</a></div></footer>
  <div class="scroll-progress" aria-hidden="true"></div>
  <script>import '../../scripts/motion'; import '../../scripts/story';</script>
</body>
</html>
