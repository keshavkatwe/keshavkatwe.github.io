---
import '../../styles/global.css';
import '../../styles/story.css';
import { projects } from '../../data/projects';
import { stories } from '../../data/stories';
export function getStaticPaths() { return projects.map((project,index) => ({ params:{slug:project.slug}, props:{project,index} })); }
const { project, index } = Astro.props;
const story = stories[project.slug];
const next = projects[(index + 1) % projects.length];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{project.name} — Engineering story · Keshav Katwe</title><meta name="description" content={story.outcome}/><link rel="canonical" href={`https://keshavkatwe.github.io/work/${project.slug}/`}/><link rel="icon" href="/favicon.svg"/><meta name="theme-color" content="#f4f1e9"/></head>
<body style={`--card:${project.color}`}>
<a class="skip" href="#main">Skip to content</a>
<header class="nav"><a class="wordmark" href="/" aria-label="Keshav Katwe home">keshav<span>✳</span></a><nav aria-label="Main navigation"><a href="/#work">All work <sup>04</sup></a><a href="/#about">A little about me</a><a class="nav-contact" href="mailto:keshav.katwe@gmail.com">Let’s talk ↗</a></nav><button id="motion-toggle" aria-pressed="false" aria-label="Pause animations">Ⅱ</button></header>
<main id="main">
<section class="story-hero section"><a class="back-link" href={`/#${project.slug}`}>← Back to selected work</a><div class="story-kicker"><span class="eyebrow">{project.number} / Engineering story</span><span>{story.scope}</span></div><h1>{project.name}<span class="story-star" aria-hidden="true">✳</span></h1><p class="story-headline">{project.headline}</p><p class="story-intro">{project.description}</p><div class="tags">{project.tags.map(tag=><span>{tag}</span>)}</div><nav class="story-jump" aria-label="In this case study"><a href="#challenge">The challenge ↓</a><a href="#decisions">Engineering decisions ↓</a><a href="#evidence">Evidence & results ↓</a></nav></section>
<section class="story-results" aria-label={`${project.name} at a glance`}>{story.results.map(result=><div><strong>{result.value}</strong><span>{result.label}</span></div>)}</section>
<section class="story-section section" id="challenge"><span class="eyebrow">01 / The challenge</span><div><h2>{project.slug==='sense' ? 'Better systems.\nBetter shipping.' : 'A product problem,\nnot just a screen.'}</h2><p>{story.problem}</p><div class="ownership"><h3>What I owned</h3><p>{story.ownership}</p></div></div></section>
<section class="story-flow section" aria-labelledby="flow-title"><div class="flow-heading"><span class="eyebrow">The system, made visible</span><h2 id="flow-title">{story.flowTitle}</h2><p>{story.flowNote}</p></div><ol class="flow-steps">{story.flow.map((step,i)=><li><a href={`#step-${i}`} aria-controls={`step-${i}`}><span class="flow-number">0{i+1}</span><strong>{step.title}</strong><span aria-hidden="true">↗</span></a></li>)}</ol><div class="flow-panels">{story.flow.map((step,i)=><section class="flow-panel" id={`step-${i}`} aria-labelledby={`step-title-${i}`}><span class="flow-number">0{i+1}</span><div><h3 id={`step-title-${i}`}>{step.title}</h3><p>{step.detail}</p></div></section>)}</div></section>
<section class="story-section section" id="decisions"><span class="eyebrow">02 / Engineering decisions</span><div class="decision-list">{story.decisions.map((decision,i)=><article><span class="decision-number">0{i+1}</span><h2>{decision.title}</h2><h3>What I built</h3><p>{decision.built}</p><h3>Why it matters</h3><p>{decision.significance}</p></article>)}</div></section>
<section class="story-evidence section" id="evidence"><div class="flow-heading"><span class="eyebrow">03 / Evidence & results</span><h2>{story.outcome}</h2><p>{story.evidence}</p></div>
{project.image && <figure class="story-figure"><img src={project.image} width={project.slug==='pushwing'?1280:1906} height={project.slug==='pushwing'?720:1280} loading="lazy" alt={project.slug==='pushwing'?'Pushwing public product website':'Agenvik published demo showing knowledge sources and agent configuration'}/><figcaption>{project.caption}</figcaption></figure>}
{project.slug==='pushwing' && <div class="story-demo"><h3>See the product in motion</h3><p>The existing public Pushwing walkthrough. Play on demand.</p><video controls preload="none" playsinline aria-label="Pushwing product walkthrough"><source src="https://pushwing.com/media/pushwing-how-it-works.mp4" type="video/mp4"/>Your browser cannot play this video. <a href="https://pushwing.com/media/pushwing-how-it-works.mp4">Open the walkthrough</a>.</video><a class="text-link" href="https://pushwing.com/media/pushwing-how-it-works.mp4" target="_blank" rel="noreferrer">Open walkthrough ↗</a></div>}
{project.url && <a class="text-link" href={project.url} target="_blank" rel="noreferrer">{project.link} ↗</a>}{project.slug==='agenvik' && <a class="text-link" href="https://agenvik.com/docs/developer-guide/overview" target="_blank" rel="noreferrer">Read the developer guide ↗</a>}
{(project.slug==='investsky'||project.slug==='sense') && <a class="text-link" href="/Keshav-Katwe-Resume.pdf" target="_blank">View résumé and reported results ↗</a>}
</section>
<section class="story-next section"><span class="eyebrow">Keep exploring</span><a href={`/work/${next.slug}/`}>{next.name}<span>↗</span></a><p>{next.headline}</p></section>
</main><footer><a class="wordmark" href="/">keshav<span>✳</span></a><p>Senior frontend & React Native engineer · Dubai</p><div><a href="mailto:keshav.katwe@gmail.com">Email ↗</a><a href="https://www.linkedin.com/in/keshavkatwe/" target="_blank" rel="noreferrer">LinkedIn ↗</a></div></footer><div class="scroll-progress" aria-hidden="true"></div>
<script>import '../../scripts/motion'; import '../../scripts/story';</script>
</body></html>
