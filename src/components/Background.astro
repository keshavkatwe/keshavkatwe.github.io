---
import { employment, education } from '../data/background';
---

<section class="journey section" id="background" aria-labelledby="journey-title">
  <div class="journey-heading">
    <div><span class="eyebrow">A little more background</span><h2 id="journey-title">The journey so far<span>.</span></h2></div>
    <p>The roles and foundations behind the work.<br/>Open any chapter for a little more detail.</p>
  </div>
  <div class="journey-layout">
    <div class="journey-career">
      <div class="journey-label"><h3>Experience</h3><span>Most recent first</span></div>
      <ol class="journey-timeline" aria-label="Employment history, most recent first">
        {employment.map(role => <li>
          <details class="journey-role">
            <summary>
              <span class="journey-dates"><time datetime={role.startDate}>{role.start}</time><span>–</span><time datetime={role.endDate}>{role.end}</time></span>
              <span class="journey-position"><strong>{role.company}</strong><span>{role.title}</span></span>
              <span class="journey-expand" aria-hidden="true">+</span>
            </summary>
            <div class="journey-detail"><p>{role.summary}</p><span>{role.location}</span></div>
          </details>
        </li>)}
      </ol>
    </div>
    <div class="journey-foundations">
      <div class="journey-label"><h3>Education</h3><span aria-hidden="true">↳</span></div>
      <div class="journey-education"><p class="journey-school-dates"><time datetime={education.start}>{education.start}</time> – <time datetime={education.end}>{education.end}</time></p><h4>{education.qualification}</h4><p>{education.institution}</p></div>
      <a class="journey-resume" href="/Keshav-Katwe-Resume.pdf" target="_blank">Keep a copy of my résumé <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  .journey.section{padding-top:0;padding-bottom:85px}
  .journey-heading{border-top:1px solid var(--line);padding-top:30px;display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:38px}
  .journey-heading .eyebrow{font-size:9px;color:var(--muted)}
  .journey-heading h2{font-size:clamp(26px,3vw,40px);font-weight:600;letter-spacing:-.055em;line-height:1.15;margin-top:12px}
  .journey-heading h2>span{color:var(--purple)}
  .journey-heading>p{color:var(--muted);font-size:11px;line-height:1.8;max-width:320px}
  .journey-layout{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);gap:7%}
  .journey-label{display:flex;justify-content:space-between;align-items:center;gap:20px;padding-bottom:15px;border-bottom:1px solid var(--line)}
  .journey-label h3,.journey-label>span{font:9px/1.5 ui-monospace,SFMono-Regular,Consolas,monospace;letter-spacing:.4px;text-transform:uppercase}
  .journey-label h3{font-weight:500}.journey-label>span{font-size:8px;color:var(--muted)}
  .journey-timeline{padding:0;margin:0;list-style:none}
  .journey-timeline>li{position:relative;border-bottom:1px solid var(--line)}
  .journey-role>summary{list-style:none;cursor:pointer;display:grid;grid-template-columns:145px minmax(0,1fr) 24px;align-items:center;gap:20px;padding:21px 0;min-height:80px}
  .journey-role>summary::-webkit-details-marker{display:none}
  .journey-dates{display:flex;gap:5px;flex-wrap:wrap;align-items:center;font:9px/1.7 ui-monospace,SFMono-Regular,Consolas,monospace;color:var(--muted)}
  .journey-dates time{white-space:nowrap}
  .journey-position{display:flex;flex-direction:column;gap:5px;min-width:0}
  .journey-position strong{font-size:15px;line-height:1.3;font-weight:600;letter-spacing:-.3px}
  .journey-position>span{font-size:11px;line-height:1.5;color:var(--muted)}
  .journey-expand{font:19px/1 monospace;text-align:center;color:var(--muted);transition:transform .2s,color .2s}
  .journey-role[open] .journey-expand{transform:rotate(45deg);color:var(--purple)}
  .journey-role>summary:hover .journey-position strong{color:var(--purple)}
  .journey-role>summary:focus-visible{outline:2px solid var(--purple);outline-offset:4px;border-radius:2px}
  .journey-detail{padding:0 44px 22px 165px}
  .journey-detail p{font-size:12px;line-height:1.85;color:var(--muted);max-width:430px}
  .journey-detail>span{display:block;margin-top:12px;font:8px/1.6 ui-monospace,SFMono-Regular,Consolas,monospace;color:var(--muted)}
  .journey-education{padding:24px 0 26px;border-bottom:1px solid var(--line)}
  .journey-school-dates{font:9px/1.6 ui-monospace,SFMono-Regular,Consolas,monospace;color:var(--muted);margin-bottom:13px}
  .journey-education h4{font-size:17px;font-weight:500;line-height:1.4;letter-spacing:-.4px;margin-bottom:8px;max-width:250px}
  .journey-education>p:last-child{font-size:11px;line-height:1.7;color:var(--muted)}
  .journey-resume{display:flex;align-items:center;justify-content:space-between;gap:20px;font-size:10px;padding:18px 0;max-width:260px}
  .journey-resume>span{font-size:18px}.journey-resume:hover{color:var(--purple)}
  @media(max-width:1000px){.journey-layout{gap:6%}.journey-role>summary{grid-template-columns:120px minmax(0,1fr) 20px;gap:15px}.journey-dates{font-size:8px;gap:4px}.journey-position>span{font-size:10px}.journey-detail{padding-left:135px;padding-right:35px}}
  @media(max-width:700px){.journey.section{padding-bottom:60px}.journey-heading{padding-top:26px;display:block;margin-bottom:30px}.journey-heading h2{font-size:29px}.journey-heading>p{font-size:11px;margin-top:15px}.journey-layout{grid-template-columns:1fr;gap:35px}.journey-role>summary{grid-template-columns:105px minmax(0,1fr) 20px;gap:13px;padding:19px 0;min-height:79px}.journey-position strong{font-size:14px}.journey-position>span{font-size:10px}.journey-dates{font-size:8px;line-height:1.8;column-gap:4px}.journey-detail{padding:0 25px 22px 118px}.journey-detail p{font-size:11px}.journey-education{padding-top:20px}.journey-education h4{max-width:none;font-size:17px}.journey-education>p:last-child{font-size:11px}.journey-resume{max-width:none}.journey-label>span{font-size:7px}}
  @media(max-width:370px){.journey-role>summary{grid-template-columns:90px minmax(0,1fr) 17px;gap:10px}.journey-dates{font-size:7px;column-gap:3px}.journey-detail{padding-left:100px;padding-right:10px}.journey-position>span{font-size:9px}}
</style>
